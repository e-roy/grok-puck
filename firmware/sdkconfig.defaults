# Waveshare ESP32-S3-Touch-LCD-1.46: ESP32-S3R8 (8 MB octal PSRAM), 16 MB quad flash, native USB.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Wi-Fi, lwIP and TLS buffers may live in PSRAM, which leaves internal RAM for DMA and the drivers.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Logs on the USB-C port (the board's only USB connection).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Setup page (HTTP server and DNS) and the bridge link need a few more sockets than the default 10.
CONFIG_LWIP_MAX_SOCKETS=16

# LVGL 9: 16-bit colour, its memory from the C library (so from PSRAM), the fonts the UI uses, and
# the QR code on the setup screen.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_QRCODE=y
# Cloudflare's edge sends GTS Root R4 cross-signed by GlobalSign Root CA, which is no longer in the
# bundle: without this the handshake fails ("No matching trusted root certificate found").
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
