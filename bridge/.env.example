# Copy to .env (never commit .env). Used by compose.yaml on the always-on machine.
# For running locally (pnpm start) none of these are needed.

# Public address of the bridge, no trailing slash. Shown in the admin page as the MCP URL.
PUBLIC_BASE_URL=https://desk.example.com

# This project's Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access for the admin hostname: your team domain and the Access application's
# "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# A pinned cloudflared image version, e.g. one from https://github.com/cloudflare/cloudflared/releases
CLOUDFLARED_VERSION=latest

LOG_LEVEL=info

# Only with compose.speech-network.yaml: the speech server's Docker network (docker network ls).
SPEECH_NETWORK=
