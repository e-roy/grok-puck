# Copy to .env (never commit .env). Used by compose.yaml on the always-on machine.
# For running locally (pnpm start) none of these are needed.

# Public address of the bridge, no trailing slash. Shown in the admin page as the MCP URL.
PUBLIC_BASE_URL=https://desk.example.com

# This project's Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access for the admin hostname:
# - your team domain: Zero Trust → Settings → Team name and domain;
# - the Access application's "Application Audience (AUD) Tag": the application's Edit → Additional settings.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# The cloudflared image version, pinned rather than "latest". Versions look like dates (2026.10.7):
# pick a release at least a week old from https://github.com/cloudflare/cloudflared/releases
CLOUDFLARED_VERSION=2026.10.7

LOG_LEVEL=info

# Speech server in Docker on the same machine (see compose.speech-network.yaml): its Docker network,
# and both compose files, so a plain `docker compose up -d` keeps the speech network.
# (On Windows the separator in COMPOSE_FILE is ; instead of :.)
SPEECH_NETWORK=
# COMPOSE_FILE=compose.yaml:compose.speech-network.yaml
