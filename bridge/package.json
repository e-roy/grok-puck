{
  "name": "desk-bridge",
  "version": "0.1.0",
  "description": "Bridge between a desk display, Grok Bot (routine webhook + MCP) and speech services",
  "license": "MIT",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "check": "tsc -p tsconfig.json && pnpm --filter desk-bridge-admin check",
    "test": "node --test test/*.test.ts",
    "build:admin": "pnpm --filter desk-bridge-admin build",
    "dev:admin": "pnpm --filter desk-bridge-admin dev",
    "fake-device": "node tools/fake-device.ts",
    "fake-grokbot": "node tools/fake-grokbot.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3"
  }
}
